# Development Environment Variables
# Copy this to .env.development and fill in your values

# API Configuration
API_BASE_URL=http://localhost:3000/api
API_TIMEOUT=30000

# Sentry Configuration (Development)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_ENABLED=false

# Feature Flags
ENABLE_REACTOTRON=true
ENABLE_DEBUG_LOGGING=true

# OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID_IOS=your_ios_client_id_here
GOOGLE_OAUTH_CLIENT_ID_ANDROID=your_android_client_id_here
GOOGLE_OAUTH_CLIENT_ID_WEB=your_web_client_id_here

# Deep Linking
DEEP_LINK_SCHEME=streamlinedproperties
