# Production Environment Variables
# Copy this to .env.production and fill in your values

# API Configuration
API_BASE_URL=https://api.streamlinedproperties.com/api
API_TIMEOUT=30000

# Sentry Configuration (Production)
SENTRY_DSN=your_production_sentry_dsn_here
SENTRY_ENVIRONMENT=production
SENTRY_ENABLED=true

# Feature Flags
ENABLE_REACTOTRON=false
ENABLE_DEBUG_LOGGING=false

# OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID_IOS=your_ios_client_id_here
GOOGLE_OAUTH_CLIENT_ID_ANDROID=your_android_client_id_here
GOOGLE_OAUTH_CLIENT_ID_WEB=your_web_client_id_here

# Deep Linking
DEEP_LINK_SCHEME=streamlinedproperties
